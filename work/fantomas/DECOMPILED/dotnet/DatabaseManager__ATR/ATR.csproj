<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ATR</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net452</TargetFramework>
    <Prefer32Bit>True</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <ApplicationConfig Remove="ATR.exe.config" />
    <ApplicationConfig Include="ATR.exe.config" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Data.SQLite">
      <HintPath>DatabaseManager/System.Data.SQLite.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="ClosedXML">
      <HintPath>DatabaseManager/ClosedXML.dll</HintPath>
    </Reference>
    <Reference Include="System.Data" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web" />
    <Reference Include="HtmlRenderer.PdfSharp">
      <HintPath>DatabaseManager/HtmlRenderer.PdfSharp.dll</HintPath>
    </Reference>
    <Reference Include="PdfSharp">
      <HintPath>DatabaseManager/PdfSharp.dll</HintPath>
    </Reference>
    <Reference Include="HtmlRenderer">
      <HintPath>DatabaseManager/HtmlRenderer.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>